# ── LINE bot ──────────────────────────────────────────────────
#
# 兩個都設才會啟用，缺任一個整包停用（webhook 回 503）。
# 本機開發請在 .env 填入真實值，.env 不進 git。
#
# 取得：LINE Developers Console → 你的 Messaging API channel
#   Channel secret       在「Basic settings」分頁
#   Channel access token 在「Messaging API」分頁最下面，按 Issue
LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=

# ── 資料庫（誰可以用這個 bot）─────────────────────────────────
#
# Postgres 連線字串。只存一張 users 表：綁定過 LINE 帳號的人才能用。
# ★ 沒設的話查不到名單，**所有人都會被當成沒有權限**。
# 開通方式見 db/schema.py。
DATABASE_URL=

# ── 以下有預設值，不設也能跑 ──

# 使用者名單的快取秒數（預設 60）。剛開通或停用的人最慢這麼久生效。
AUTH_CACHE_TTL_SECONDS=

# 呼叫 LINE API 的逾時秒數（預設 5）。
LINE_TIMEOUT_SECONDS=
# 本機啟動的 port（預設 5001；macOS 的 AirPlay 接收器佔用 5000）。
PORT=
